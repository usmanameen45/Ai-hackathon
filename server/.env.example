NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/myapp

# Frontend origin (React / Vite)
CLIENT_URL=http://localhost:5173

# Better Auth (auto-generated into .env on `npm i` if left as the placeholder)
BETTER_AUTH_SECRET=replace-with-a-long-random-string-min-32-chars
BETTER_AUTH_URL=http://localhost:5000

# Optional: leave blank to disable a provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
